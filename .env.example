
#  PostgreSQL used by the pipeline 
# Inside Docker Compose the host is overridden to "postgres" automatically.
# Keep "localhost" if you run the pipeline directly on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=firerisk
POSTGRES_USER=firerisk
POSTGRES_PASSWORD=change_me_pipeline

# Port published on your machine by docker compose.
# Change it (for example to 5433) if you already have PostgreSQL installed.
POSTGRES_HOST_PORT=5432

# Airflow metadata database (created automatically on the first start) 
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow

# Port for the Airflow web UI on your machine.
AIRFLOW_HOST_PORT=8080

# Linux / WSL only: put the output of `id -u` here so files written by the
# containers into this folder belong to you. Windows/macOS can keep 50000.
AIRFLOW_UID=50000

# Pipeline runtime 
# DEBUG shows more detail in the console log; the JSON log file always keeps INFO+.
PIPELINE_LOG_LEVEL=INFO
