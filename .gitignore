# ---------------------------------------------------------------
# Secrets and machine-specific settings (NEVER commit these)
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Python / tooling
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# ---------------------------------------------------------------
# Data layers. Everything here is regenerated by the pipeline,
# so only the folder placeholders are versioned.
# The source CSV is not committed by default (see data/source/README.md).
# ---------------------------------------------------------------
data/source/*
!data/source/README.md
data/raw/*
!data/raw/.gitkeep
data/staging/*
!data/staging/.gitkeep
data/curated/*
!data/curated/.gitkeep
data/partitioned/*
!data/partitioned/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
data/model_input/*
!data/model_input/.gitkeep

# ---------------------------------------------------------------
# Runtime state, logs and heavy/run-specific outputs
# (small deterministic outputs such as metrics.json ARE committed)
# ---------------------------------------------------------------
state/*
!state/.gitkeep
logs/*
!logs/.gitkeep
!logs/airflow/
logs/airflow/*
!logs/airflow/.gitkeep
outputs/model/*
!outputs/model/.gitkeep
!outputs/model/model_card.json
outputs/runs/
outputs/quality/
outputs/benchmark/files/
outputs/drills/

# Airflow files created when running Airflow outside Docker
airflow_home/

# ---------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
